{
  "schemaVersion": 1,
  "id": "silent_knock",
  "version": "${version}",
  "name": "SilentSPA",
  "description": "Client-side SPA knocking: asynchronously sends a standard fwknop UDP knock before connecting to a server protected by fwknopd, then carries on with the vanilla connection once the firewall has let your address through.",
  "authors": [
    "AutoMods/griffindor512"
  ],
  "credits": "griffindor512",
  "license": "MMPL-1.0.1",
  "icon": "assets/silent_knock/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cn.blockforge.generated.silentknock.SilentSpaClient"
    ],
    "modmenu": [
      "cn.blockforge.generated.silentknock.compat.SilentSpaModMenu"
    ]
  },
  "mixins": [
    "silent_knock.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.13",
    "minecraft": "~1.21.8",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": ">=15.0.0"
  }
}
